{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingoMusic Downloader",
  "version": "2.2.0",
  "identifier": "com.lingomusic.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LingoMusic Downloader",
        "width": 1180,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:",
          "https://*.mzstatic.com",
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ],
        "media-src": [
          "'self'",
          "blob:",
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "script-src": ["'self'"],
        "worker-src": ["'self'", "blob:"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://127.0.0.1:8000",
          "http://localhost:8000",
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "ws://localhost:5173",
          "ws://127.0.0.1:5173"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:",
          "https://*.mzstatic.com",
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ],
        "media-src": [
          "'self'",
          "blob:",
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "script-src": ["'self'", "'unsafe-eval'"],
        "worker-src": ["'self'", "blob:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "backend-dist/run_backend/": "backend/",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    }
  }
}
